---
import "../styles/touche.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Touché mapping editor</title>
  </head>
  <body>
    <header class="top">
      <div class="brand">
        <h1>Touché → VR-09</h1>
        <a href="/">Library</a>
        <a href="/touche-bridge.html">Bridge test bench</a>
      </div>
      <div class="connection">
        <button id="connect" class="primary">Connect MIDI</button>
        <label class="toggle" title="While live, moving an axis writes to the keyboard's current sound (never to its saved registrations)">
          <input id="live" type="checkbox" checked /> Live
        </label>
        <span class="muted">sent <b id="sent">0</b></span>
        <details class="ports">
          <summary id="port-summary">Ports</summary>
          <label><span>Touché</span><select id="port-touche"></select></label>
          <label><span>VR-09 in</span><select id="port-vr09-in"></select></label>
          <label><span>VR-09 out</span><select id="port-vr09-out"></select></label>
        </details>
      </div>
    </header>

    <div class="loaders">
      <section class="loader">
        <h2>Keyboard sound</h2>
        <div class="line">
          <select id="sound-registration" title="A registration of the library"></select>
          <button id="load-registration">Load registration</button>
          <label class="small"><input id="with-pairing" type="checkbox" /> with its paired mapping</label>
        </div>
        <div class="line">
          <select id="sound-tone" title="One tone of Roland's list, alone on the upper part"></select>
          <button id="load-tone">Load single tone</button>
          <button id="read-keyboard" title="Read the keyboard's stored values to show them on the panel">Read keyboard</button>
        </div>
      </section>
      <section class="loader">
        <h2>Mapping <span id="mapping-dirty" class="dirty" hidden title="Unsaved changes">●</span></h2>
        <div class="line">
          <select id="mapping-list"></select>
          <button id="mapping-load">Load</button>
          <button id="mapping-new">New</button>
          <button id="mapping-save" class="primary" title="Ctrl/Cmd+S">Save</button>
          <button id="mapping-save-as" title="Ctrl/Cmd+Shift+S">Save as…</button>
          <button id="mapping-revert">Revert</button>
        </div>
        <div class="line">
          <b id="mapping-name"></b> <span id="mapping-source" class="muted"></span>
          <input id="mapping-type" placeholder="patch type" />
          <input id="mapping-summary" placeholder="summary" class="wide" />
        </div>
      </section>
    </div>

    <div id="status" class="muted">Loading…</div>

    <nav id="tabs" class="tabs">
      <button data-tab="panel" class="on">Panel</button>
      <button data-tab="mods">Modulations</button>
    </nav>

    <main id="view-panel">
      <aside class="touche">
        <div class="touche-body">
          <div class="touche-plate"></div>
          <div class="touche-buttons"><span></span><span></span></div>
        </div>
        <h2>Touché sources</h2>
        <p class="muted small">Drag an axis onto a keyboard control.</p>
        <div id="sources"></div>
        <p class="muted small" id="buttons"></p>
      </aside>
      <div class="vr09">
        <div class="vr09-head"><b>Roland</b> V-Combo VR-09 <span class="muted small">— hollow dot: value at rest, filled dot and arrow: value at full travel, white dot: live</span></div>
        <div id="keyboard"></div>
        <div id="selection" class="selection"></div>
      </div>
    </main>

    <main id="view-mods" hidden>
      <div class="line">
        <button id="add-mod">Add modulation</button>
        <span class="muted small">Low is sent with the axis at rest, high at full travel; a low above high inverts. The window is the part of the axis travel that sweeps the range.</span>
      </div>
      <table class="mods">
        <thead>
          <tr><th>Source</th><th>Destination</th><th>Low</th><th>High</th><th>Axis from</th><th>Axis to</th><th>Curve</th><th>Shape</th><th>Live</th><th></th></tr>
        </thead>
        <tbody id="mods-body"></tbody>
      </table>
    </main>

    <dialog id="modal">
      <p id="modal-message"></p>
      <input id="modal-input" hidden />
      <div id="modal-buttons" class="line"></div>
    </dialog>

    <script>
      import "../scripts/touche/editor.ts";
    </script>
  </body>
</html>

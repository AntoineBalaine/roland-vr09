---
import "../styles/style.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Patch library</title>
  </head>
  <body>
    <div id="lock" hidden>A capture is running: changes are disabled until it stops (q at its prompt).</div>
    <header>
      <h1>Patch library</h1>
      <nav>
        <button class="tab on" id="tab-library">Library</button>
        <button class="tab" id="tab-setlist">Setlist <span id="setlist-count"></span></button>
        <button class="tab" id="tab-pairings">Pairings</button>
        <a class="tab" href="/touche" title="The Touché mapping editor">Touché</a>
      </nav>
      <input id="q" type="search" placeholder="Search title, tone, effect, key" autofocus />
      <label id="todo-label"><input id="todo" type="checkbox" /> not reviewed only</label>
      <span id="count"></span>
    </header>
    <main id="library" class="grid"></main>
    <section id="setlist" hidden>
      <div class="bar">
        <button id="reload">Reload from the file</button>
        <button id="clear">Clear</button>
      </div>
      <p class="hint">
        Every change here is saved at once to the setlist file; then run <code>pedal_scenes.py</code> with it. Add
        patches from the Library tab.
      </p>
      <ol id="items"></ol>
    </section>
    <section id="pairings" hidden>
      <p class="hint">
        Each row pairs a registration (a patch of the library) with the mapping the Touché should use for it. A change is
        saved at once, in the <code>touche</code> field of the patch in <code>library/catalog.yaml</code>. Choosing a
        registration fills in a mapping suggested from its sound (the sections that sound and the group of its synth tone).
      </p>
      <div class="bar">
        <button id="pair-add">Add a pairing</button>
        <button id="pair-suggest" class="primary">Pair the unpaired patches from their sounds</button>
        <button id="pair-redo">Re-pair every patch from its sounds</button>
        <span id="pair-count"></span>
      </div>
      <table id="pair-table"></table>
    </section>
    <div id="toast"></div>
    <script>
      import "../scripts/app.ts";
    </script>
  </body>
</html>
